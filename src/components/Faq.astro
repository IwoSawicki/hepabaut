---
import type { FaqItem } from '../data/leistungen';
interface Props {
  heading: string;
  items: FaqItem[];
}
const { heading, items } = Astro.props;
---
{items.length > 0 && (
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="mb-8 text-2xl font-bold sm:text-3xl">{heading}</h2>
    <div class="divide-y divide-black/10 border-y border-black/10">
      {items.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
            {item.q}
            <span class="text-[var(--color-brand-accent)] transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[var(--color-muted)]">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
