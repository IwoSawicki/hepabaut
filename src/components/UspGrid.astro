---
// „Hepa Baut: Sauber, Zuverlässig und on-time" / „Warum HepaBaut" — USP-Artikel (2×2-Grid 01–04).
// Auf jeder Seite fast identisch; Unterschiede als Props: Artikel-Klasse, CTA-Variante,
// Original-Node-IDs (steuern justify-self:end der rechten Spalte via #w-node-CSS).
import { usps as defaultUsps } from '../data/site';

interface Usp {
  title: string;
  text: string;
}
type CtaVariant = 'primary4-phone' | 'buttons-row-phone' | 'buttons-row-only';
interface Props {
  heading: string;
  headingSpanClass?: string;
  usps?: readonly Usp[];
  articleClass?: string;
  ctaVariant?: CtaVariant;
  ctaLabel?: string;
  ctaBtnClass?: string;
  /** Ziel des Haupt-CTA (Standard /kontakt; Ads-LP setzt hier den On-Page-Anker #form-hero). */
  ctaHref?: string;
  /** tel:-Href der Telefonzeile (Original variiert zwischen den Seiten) */
  telHref?: string;
  /** Original-w-node-IDs für Item 2 und 4 (justify-self:end im Original-CSS) */
  nodeIds?: [string, string];
}
const {
  heading,
  headingSpanClass,
  usps = defaultUsps,
  articleClass = 'section pd-120px',
  ctaVariant = 'primary4-phone',
  ctaLabel = 'Unverbindlich Beraten',
  ctaBtnClass = 'btn-primary-2 w-inline-block',
  ctaHref = '/kontakt',
  telHref = 'tel:+4962061857728',
  nodeIds = ['w-node-c4fd44da-1ffe-0352-b5d9-f3e43ebd8839-f0fa7cd8', 'w-node-c4fd44da-1ffe-0352-b5d9-f3e43ebd8849-f0fa7cd8'],
} = Astro.props;
// On-Page-Anker (#…) nicht in neuem Tab öffnen; interne Seiten wie im Original mit _blank.
const ctaTarget = ctaHref.startsWith('#') ? undefined : '_blank';
---
<div>
  <article id="vorteile" class={articleClass}>
    <div class="w-layout-blockcontainer container-default-2 w-container">
      <div class="mg-bottom-64px">
        <div class="inner-container _877px center">
          <div class="inner-container _700px---tablet center">
            <div class="inner-container _600px---mbl center">
              <div class="text-center-2">
                <div class="accent-line-2 center"></div>
                <h2 class="display-5"><span class={headingSpanClass}>{heading}</span></h2>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="w-layout-grid grid-2-columns gap-32px">
        {usps.map((u, i) => (
          <div id={i === 1 ? nodeIds[0] : i === 3 ? nodeIds[1] : undefined} class="value-wrapper">
            <div class="display-6 mg-right-34px value-number">{String(i + 1).padStart(2, '0')}</div>
            <div class="value-content">
              <h3 class="heading-h2-size-2 mg-bottom-16px">{u.title}</h3>
              <p class="mg-bottom-0">{u.text}</p>
            </div>
          </div>
        ))}
      </div>
      {ctaVariant === 'primary4-phone' && (
        <div class="flex-horizontal gap-20 mg-top-32px">
          <a href={ctaHref} target={ctaTarget} class="btn-primary-4 w-button">{ctaLabel}</a>
          <a href={telHref} class="cta-telefonnummer w-inline-block">
            <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/682f0a2854d6f9fb2051432f_phone-call.png" loading="lazy" alt="" class="image-3" />
            <p class="cta-telefonnummer black">06206 185 7728</p>
          </a>
        </div>
      )}
      {ctaVariant === 'buttons-row-phone' && (
        <div class="mg-top-32px">
          <div class="buttons-row center">
            <a href={ctaHref} class="btn-primary button-row w-inline-block">
              <div class="flex-horizontal">
                <div>{ctaLabel}</div>
                <div class="arrow-icon">&#xE900;</div>
              </div>
            </a>
            <a href={telHref} class="cta-telefonnummer w-inline-block">
              <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/682f0a2854d6f9fb2051432f_phone-call.png" loading="lazy" alt="" class="image-3" />
              <p class="cta-telefonnummer">06206 185 7728</p>
            </a>
          </div>
        </div>
      )}
      {ctaVariant === 'buttons-row-only' && (
        <div class="mg-top-32px">
          <div class="buttons-row center">
            <a href={ctaHref} class={ctaBtnClass}>
              <div class="flex-horizontal">
                <div>{ctaLabel}</div>
                <div class="arrow-icon">&#xE900;</div>
              </div>
            </a>
          </div>
        </div>
      )}
    </div>
  </article>
</div>
