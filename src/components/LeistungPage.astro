---
import { usps, site } from '../data/site';
import { withOrt, type Leistung } from '../data/leistungen';
import Faq from './FaqAccordion.astro';

interface Props {
  leistung: Leistung;
  ortName: string; // konkreter Ort ODER generisch ("Ihrer Stadt") auf der Übersichtsseite
}
const { leistung: l, ortName } = Astro.props;
const h1 = withOrt(l.heroH1Template, ortName);
---
<!-- Hero -->
<section class="bg-neutral-50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <h1 class="max-w-3xl text-3xl font-bold leading-tight sm:text-5xl">{h1}</h1>
    {l.heroSubline && <p class="mt-3 text-xl text-[var(--color-muted)] sm:text-2xl">{l.heroSubline}</p>}
    {l.heroLead && <p class="mt-4 max-w-2xl text-[var(--color-muted)]">{l.heroLead}</p>}
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="/kontakt" class="rounded-full bg-[var(--color-brand)] px-6 py-3 font-semibold text-white">{l.heroCtaLabel}</a>
      <a href={`tel:${site.phonePrimaryHref}`} class="font-semibold text-[var(--color-brand-accent)]">{site.phonePrimary}</a>
    </div>
  </div>
</section>

<!-- Erste Hilfe (nur Wasserschaden) -->
{l.emergency && (
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="mb-8 text-2xl font-bold sm:text-3xl">{l.emergency.heading}</h2>
    <ol class="grid gap-6 sm:grid-cols-2">
      {l.emergency.steps.map((step, i) => (
        <li class="rounded-xl border border-black/10 p-6">
          <div class="mb-2 text-sm font-bold text-[var(--color-brand-accent)]">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="font-semibold">{step.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{step.text}</p>
          {step.tip && <p class="mt-2 text-sm"><span class="font-semibold">Tipp:</span> {step.tip}</p>}
        </li>
      ))}
    </ol>
  </section>
)}

<!-- Leistungen -->
<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="text-2xl font-bold sm:text-3xl">{l.leistungenHeading}</h2>
  {l.leistungenIntro && <p class="mt-3 max-w-2xl text-[var(--color-muted)]">{l.leistungenIntro}</p>}

  {l.cards.length > 0 && (
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {l.cards.map((card, i) => (
        <article class="rounded-xl border border-black/10 p-6">
          <div class="mb-2 text-sm font-bold text-[var(--color-brand-accent)]">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="font-semibold">{card.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{withOrt(card.text, ortName)}</p>
        </article>
      ))}
    </div>
  )}

  {l.bullets && (
    <ul class="mt-8 grid list-disc gap-2 pl-5 text-[var(--color-muted)] sm:grid-cols-2">
      {l.bullets.map((b) => <li>{b}</li>)}
    </ul>
  )}
</section>

<!-- Warum HePa Baut (USP) -->
<section class="bg-neutral-50">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="mb-8 text-2xl font-bold sm:text-3xl">HePa Baut: Sauber, Zuverlässig und on-time</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {usps.map((u, i) => (
        <div>
          <div class="mb-2 text-sm font-bold text-[var(--color-brand-accent)]">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="font-semibold">{u.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{u.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<Faq heading={l.faqHeading ?? 'Oft gestellte Fragen'} items={l.faq} />

<!-- CTA -->
<section class="mx-auto max-w-6xl px-4 py-16 text-center">
  <h2 class="text-2xl font-bold sm:text-3xl">Holen Sie sich jetzt ein unverbindliches Angebot ein</h2>
  <div class="mt-6 flex flex-wrap justify-center gap-4">
    <a href="/kontakt" class="rounded-full bg-[var(--color-brand)] px-6 py-3 font-semibold text-white">Kontaktieren</a>
    <a href={`tel:${site.phonePrimaryHref}`} class="font-semibold text-[var(--color-brand-accent)]">{site.phonePrimary}</a>
  </div>
</section>
