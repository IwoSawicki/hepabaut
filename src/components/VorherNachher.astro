---
// Vorher/Nachher-Paare (Startseite) — Grid mit Labels, 1:1 aus mirror-v3 (kein JS nötig).
import { vorherNachher } from '../data/startseite';

interface Props {
  heading?: string;
}
const { heading = 'Vorher / Nachher' } = Astro.props;
---
<div class="mg-section">
  <section class="section pd-230px pd-top-104px custom">
    <div class="w-layout-blockcontainer container-default w-container">
      <div class="inner-container _500px---mbl">
        <div class="z-index-1">
          <div class="mg-bottom-64px">
            <div class="inner-container _513px _100-mbl">
              <div class="inner-container _450px---tablet _100-mbl">
                <div class="accent-line"></div>
                <h2 class="display-2 mg-bottom-0">{heading}</h2>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="vorher-nachher-wrapper">
        {vorherNachher.map((paar) => (
          <div class="vorher-nachher-element">
            <div class="vorhernachher-bild-wrapper">
              <div class="vorhernachher-label"><div>Vorher</div></div>
              <img src={encodeURI(paar.vorher)} loading="lazy" alt="" class="vorher-nachher-bild" />
            </div>
            <div class="vorhernachher-bild-wrapper">
              <img src={encodeURI(paar.nachher)} loading="lazy" alt="" class="vorher-nachher-bild" />
              <div class="vorhernachher-label"><div>Nachher</div></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>
