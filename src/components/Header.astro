---
// Header 1:1 aus mirror-v3. Zwei Varianten (wie im Original):
//  - overlay: Startseite — position-absolute über dem dunklen Hero, weiße Nav-Links.
//  - solid:  alle Innenseiten — im normalen Fluss, dunkle Nav-Links.
// Mobile-Menü: CSS-only Checkbox-Toggle (kein Client-JS), data-collapse="medium" (≤991px).
interface Props {
  variant?: 'overlay' | 'solid';
}
const { variant = 'solid' } = Astro.props;
const isOverlay = variant === 'overlay';
const navLinkClass = isOverlay
  ? 'header-nav-link white---black-tablet white w-nav-link'
  : 'header-nav-link w-nav-link';
---
<div class:list={[isOverlay && 'position-relative']}>
  <div class:list={[isOverlay && 'position-absolute header-top']}>
    <div role="banner" class="header-wrapper w-nav">
        <div class="container-default w-container">
          <div class="header-content-wrapper">
            <div class="header-left-side">
              <a href="/" class="header-logo-link w-nav-brand">
                <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/682f08cbafd4c6f4363d9656_Logo-HepaBaut-455x213.png" alt="HePa Baut Logo" class="header-logo" />
              </a>
            </div>
            <div class="header-center">
              <nav role="navigation" class="header-nav-menu-wrapper w-nav-menu" id="nav-menu">
                <ul role="list" class="header-nav-menu-list w-list-unstyled">
                  <li class="header-nav-list-item middle"><a href="/" class={navLinkClass}>Home</a></li>
                  <li class="header-nav-list-item middle"><a href="/sanierung" class={navLinkClass}>Sanierung</a></li>
                  <li class="header-nav-list-item middle"><a href="/renovierung" class={navLinkClass}>Renovierung</a></li>
                  <li class="header-nav-list-item middle"><a href="/wasserschaden" class={navLinkClass}>Wasserschäden</a></li>
                  <li class="header-nav-list-item show-in-tablet header-btn">
                    <a href="/kontakt" class="btn-primary small width-100 w-button">Kontakt</a>
                  </li>
                </ul>
              </nav>
            </div>
            <div class="header-right-side">
              <a href="/kontakt" class="header-nav-link white---black-tablet hidden w-nav-link">Rückruf vereinbaren</a>
              <a href="/kontakt" class="btn-primary small header-btn-hidde-on-mb w-button">Angebot einholen</a>
              <label for="nav-toggle" class="hamburger-menu-btn w-nav-button" aria-label="Menü öffnen">
                <div class="hamburger-menu-wrapper">
                  <div class="hamburger-menu-bar top"></div>
                  <div class="hamburger-menu-bar bottom"></div>
                </div>
              </label>
            </div>
          </div>
        </div>
        <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-hidden="true" />
      </div>
    </div>
</div>

<style is:global>
  .nav-toggle-checkbox { display: none; }
  @media screen and (max-width: 991px) {
    .header-wrapper { position: relative; }
    .header-wrapper:has(.nav-toggle-checkbox:checked) .w-nav-menu {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 100;
    }
    .header-wrapper:has(.nav-toggle-checkbox:checked) .hamburger-menu-bar.top {
      transform: translateY(4.5px) rotate(45deg);
    }
    .header-wrapper:has(.nav-toggle-checkbox:checked) .hamburger-menu-bar.bottom {
      transform: translateY(-4.5px) rotate(-45deg);
    }
    .hamburger-menu-bar { transition: transform 0.3s; }
  }
</style>
