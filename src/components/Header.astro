---
import { nav, site } from '../data/site';
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---
<header class="border-b border-black/10 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="text-lg font-bold tracking-tight">{site.name}</a>
    <nav aria-label="Hauptnavigation" class="hidden items-center gap-6 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'text-sm hover:text-[var(--color-brand-accent)]',
            isActive(item.href) && 'font-semibold text-[var(--color-brand-accent)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a
      href={`tel:${site.phonePrimaryHref}`}
      class="rounded-full bg-[var(--color-brand)] px-4 py-2 text-sm font-semibold text-white"
    >
      Rückruf vereinbaren
    </a>
  </div>
</header>
