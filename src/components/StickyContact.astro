---
// Schwebende Kontakt-Buttons (WhatsApp + Anruf) — auf allen Seiten, v. a. Mobil ein starker
// Conversion-Hebel im Handwerk. Inline-SVG-Icons (keine Font-/Bild-Abhängigkeit).
import { site } from '../data/site';
// WhatsApp erwartet die Nummer ohne + / Leerzeichen. Primärnummer verwenden.
const waNumber = site.phonePrimaryHref.replace(/[^0-9]/g, '');
const waText = encodeURIComponent('Hallo HePa Baut, ich interessiere mich für ein unverbindliches Angebot.');
---
<div class="sticky-contact" aria-label="Schnellkontakt">
  <a
    class="sticky-contact__btn sticky-contact__btn--wa"
    href={`https://wa.me/${waNumber}?text=${waText}`}
    target="_blank"
    rel="noopener"
    aria-label="Per WhatsApp schreiben"
  >
    <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" fill="currentColor">
      <path d="M16.04 3C9.4 3 4 8.4 4 15.04c0 2.12.56 4.19 1.62 6.01L4 29l8.13-1.58a12 12 0 0 0 3.9.65h.01c6.64 0 12.04-5.4 12.04-12.04C28.08 8.4 22.68 3 16.04 3Zm0 21.9h-.01a10 10 0 0 1-5.09-1.39l-.36-.22-4.82.94.96-4.7-.24-.38a9.9 9.9 0 0 1-1.52-5.31c0-5.49 4.47-9.96 9.97-9.96 2.66 0 5.16 1.04 7.04 2.92a9.9 9.9 0 0 1 2.92 7.05c0 5.5-4.47 9.96-9.87 9.96Zm5.47-7.46c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
    </svg>
  </a>
  <a
    class="sticky-contact__btn sticky-contact__btn--call"
    href={`tel:${site.phonePrimaryHref}`}
    aria-label="Jetzt anrufen"
  >
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
      <path d="M6.62 10.79a15.15 15.15 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/>
    </svg>
    <span class="sticky-contact__label">Anrufen</span>
  </a>
</div>

<style is:global>
  .sticky-contact {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 900;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }
  .sticky-contact__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #fff;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(6, 49, 55, 0.28);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }
  .sticky-contact__btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(6, 49, 55, 0.34);
    filter: brightness(1.05);
  }
  .sticky-contact__btn--wa {
    width: 58px;
    height: 58px;
    background-color: #25d366;
  }
  .sticky-contact__btn--call {
    height: 58px;
    padding: 0 22px 0 18px;
    background-color: var(--accent--primary-1, #06c35d);
    font-family: 'Onest', sans-serif;
    font-weight: 500;
    font-size: 16px;
  }
  /* Auf kleinen Screens nur Icons (Platz sparen) */
  @media screen and (max-width: 479px) {
    .sticky-contact { right: 14px; bottom: 14px; gap: 10px; }
    .sticky-contact__btn--wa { width: 52px; height: 52px; }
    .sticky-contact__btn--call { width: 52px; height: 52px; padding: 0; }
    .sticky-contact__label { display: none; }
  }
</style>
