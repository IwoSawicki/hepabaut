---
// Schwebender Anruf-Button — auf allen Seiten, v. a. Mobil ein starker Conversion-Hebel im
// Handwerk. Inline-SVG-Icon (keine Font-/Bild-Abhängigkeit).
// (WhatsApp entfernt: die Rufnummer ist nicht bei WhatsApp registriert.)
import { site } from '../data/site';
---
<div class="sticky-contact" aria-label="Schnellkontakt">
  <a
    class="sticky-contact__btn sticky-contact__btn--call"
    href={`tel:${site.phonePrimaryHref}`}
    aria-label="Jetzt anrufen"
  >
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
      <path d="M6.62 10.79a15.15 15.15 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/>
    </svg>
    <span class="sticky-contact__label">Anrufen</span>
  </a>
</div>

<style is:global>
  .sticky-contact {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 900;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }
  .sticky-contact__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #fff;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(6, 49, 55, 0.28);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }
  .sticky-contact__btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(6, 49, 55, 0.34);
    filter: brightness(1.05);
  }
  .sticky-contact__btn--call {
    height: 58px;
    padding: 0 22px 0 18px;
    background-color: var(--accent--primary-1, #06c35d);
    font-family: 'Onest', sans-serif;
    font-weight: 500;
    font-size: 16px;
  }
  /* Auf kleinen Screens nur Icons (Platz sparen) */
  @media screen and (max-width: 479px) {
    .sticky-contact { right: 14px; bottom: 14px; gap: 10px; }
    .sticky-contact__btn--call { width: 52px; height: 52px; padding: 0; }
    .sticky-contact__label { display: none; }
  }
</style>
