---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** JSON-LD Objekte, die in den <head> geschrieben werden. */
  jsonLd?: Record<string, unknown>[];
  /** overlay = transparenter Header über dunklem Hero (Startseite); solid = Innenseiten. */
  headerVariant?: 'overlay' | 'solid';
}

const { title, description, jsonLd = [], headerVariant = 'solid' } = Astro.props;
// Saubere Canonical ohne .html / Trailing-Slash — muss 1:1 zur Original-URL passen (ranking-kritisch).
const cleanPath =
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site).href.replace(/\/$/, cleanPath === '/' ? '/' : '');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7f06_favicon-hepasolar.png" />
    <link rel="apple-touch-icon" href="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7f07_touchicon-hepasolar.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <div class="page-wrapper">
      <Header variant={headerVariant} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
