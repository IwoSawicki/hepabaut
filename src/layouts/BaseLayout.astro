---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyContact from '../components/StickyContact.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** JSON-LD Objekte, die in den <head> geschrieben werden. */
  jsonLd?: Record<string, unknown>[];
  /** overlay = transparenter Header über dunklem Hero (Startseite); solid = Innenseiten. */
  headerVariant?: 'overlay' | 'solid';
}

const { title, description, jsonLd = [], headerVariant = 'solid' } = Astro.props;
// Saubere Canonical ohne .html / Trailing-Slash — muss 1:1 zur Original-URL passen (ranking-kritisch).
const cleanPath =
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site).href.replace(/\/$/, cleanPath === '/' ? '/' : '');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7f06_favicon-hepasolar.png" />
    <link rel="apple-touch-icon" href="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7f07_touchicon-hepasolar.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <div class="page-wrapper">
      <Header variant={headerVariant} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <StickyContact />

    <!--
      Formular-Absenden via FormSubmit.co (Progressive Enhancement):
      - Ohne JS: normales POST an formsubmit.co → Standard-Danke-Seite (funktioniert weiterhin).
      - Mit JS: AJAX-Absenden, bleibt auf der Seite, zeigt die vorhandene .w-form-done-Meldung.
      Hinweis: FormSubmit schickt bei der ERSTEN Absendung eine Aktivierungs-Mail an die
      Zieladresse — einmal bestätigen, danach kommen alle Anfragen direkt an.
    -->
    <script is:inline>
      document.querySelectorAll('form[data-ajax-form]').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const wrap = form.closest('.w-form') || form.parentElement;
          const done = wrap && wrap.querySelector('.w-form-done');
          const fail = wrap && wrap.querySelector('.w-form-fail');
          const btn = form.querySelector('[type="submit"]');
          const label = btn && (btn.value || btn.textContent);
          if (btn) { btn.disabled = true; if ('value' in btn) btn.value = btn.getAttribute('data-wait') || 'Bitte warten...'; }
          try {
            const data = Object.fromEntries(new FormData(form).entries());
            const res = await fetch(form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/'), {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(data),
            });
            if (res.ok) {
              form.style.display = 'none';
              if (done) done.style.display = 'block';
            } else {
              throw new Error('bad status');
            }
          } catch (err) {
            if (fail) fail.style.display = 'block';
          } finally {
            if (btn) { btn.disabled = false; if ('value' in btn && label) btn.value = label; }
          }
        });
      });
    </script>
  </body>
</html>
