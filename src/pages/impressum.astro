// Adresse (Mörlenbach) ggü. Footer (Bürstadt) — in Phase 1 bewusst 1:1, Klärung in Phase 2.
---
<BaseLayout title="Impressum - Hepa Solar">
  <section class="section hero v20">
    <div class="w-layout-blockcontainer container-default w-container">
      <div class="inner-container _777px center">
        <div class="text-center">
          <h1 class="display-1">Impressum</h1>
          <div class="inner-container _662px center">
            <p class="mg-bottom-0">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua massa <span class="text-no-wrap">sed elementum.</span></p>
          </div>
        </div>
      </div>
    </div>
    <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7ebd_line-hero-v20-startply-x-webflow-template.svg" alt="" class="floating-item hero-v20" />
  </section>

  <section class="section pd-top-104px">
    <div class="w-layout-blockcontainer container-default w-container">
      <div class="inner-container _822px center">
        <div class="inner-container _700px---tablet center _100-mbl">
          <div class="mg-bottom-32px">
            <div class="mg-bottom--16px">
              <div class="rich-text-v4 w-richtext">
                <h2>Verantwortlich für den Inhalt</h2>
