---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceTiles from '../components/ServiceTiles.astro';
import UspGrid from '../components/UspGrid.astro';
import Projekte from '../components/Projekte.astro';
import VorherNachher from '../components/VorherNachher.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { site } from '../data/site';

// FAQ 1:1 aus mirror-v3 (Startseite).
const faq = [
  { q: 'Was kostet eine Sanierung oder Renovierung?', a: 'Die Kosten variieren je nach Zustand und Größe der Immobilie sowie nach gewünschter Leistung. Nach einem kostenlosen Vor-Ort-Termin erstellen wir ein individuelles, transparentes Angebot – ohne versteckte Kosten oder böse Überraschungen.' },
  { q: 'Was unterscheidet HEPA BAUT von anderen Handwerksfirmen?', a: 'Wir beraten Sie offen und transparent und sagen Ihnen klar, was aus unserer Sicht die beste Lösung ist. Ihre Wünsche stehen dabei immer im Mittelpunkt – auch dann, wenn Sie sich für eine andere Umsetzung entscheiden' },
  { q: 'Wie läuft ein typisches Projekt ab?', a: 'Zunächst besichtigen wir das Objekt kostenlos vor Ort. Danach erhalten Sie ein Angebot mit Zeitplan. Sobald Sie freigeben, beginnen wir mit der Ausführung – strukturiert, sauber und termingetreu. Am Ende erfolgt die gemeinsame Abnahme.' },
  { q: 'Kann ich nur einzelne Räume renovieren oder sanieren lassen?', a: 'Ja, wir übernehmen auch kleinere Arbeiten – etwa einzelne Räume, Küchen, Bäder oder Flure. Sie müssen kein Komplettpaket buchen – wir richten uns nach Ihrem Bedarf.' },
  { q: 'Bietet ihr alles aus einer Hand an?', a: 'Nicht alles – aber vieles. Wir übernehmen die wichtigsten Arbeiten im Bereich Sanierung und Renovierung selbst. Wenn zusätzliche Gewerke nötig sind (z. B. Elektrik oder Heizung), holen wir bewährte Partnerfirmen hinzu und koordinieren die Abläufe für Sie. So haben Sie trotzdem nur einen Ansprechpartner und einen klaren Ablaufplan.' },
  { q: 'Arbeitet ihr nur an einem festen Standort oder auch darüber hinaus?', a: 'Wir sind flexibel im Einsatz und arbeiten in einem größeren Umkreis – je nach Projektgröße und Aufwand. Fragen Sie gerne unverbindlich an – wir prüfen, ob wir Ihr Projekt betreuen können.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: site.name,
    legalName: site.legalName,
    telephone: site.phonePrimary,
    email: site.emailKontakt,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.addressStreet,
      addressLocality: site.addressCity,
      addressCountry: 'DE',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Startseite - HePa Baut - Sanierung & Renovierung"
  description="Sanierung & Renovierung vom Profi im Raum Heidelberg, Mannheim & Bergstraße: von kleinen Reparaturen über Renovierung bis Komplettsanierung und schnelle Hilfe bei Wasserschäden."
  jsonLd={jsonLd}
  headerVariant="overlay"
>
  <!-- Hero (hero-v1, Hintergrundbild + Verlauf via CSS) -->
  <div class="mg-section mg-top-16px">
    <section class="section hero-full hero-v1">
      <div class="container-default w-container">
        <div class="inner-container hero-start customwidth">
          <div class="inner-container _500px---mbl customwidth">
            <h1 class="display-1 color-neutral-100">Sanierung &amp;&nbsp;Renovierung <br />vom Profi</h1>
            <div>
              <p class="color-neutral-100 mg-bottom-32px">Von kleinen Reparaturen, über&nbsp;Renovierung, bis hin zur Komplettsanierung, oder schnelle Hilfe bei Wasserschäden: Wir koordinieren alle Gewerke und liefern termintreu.</p>
            </div>
            <div class="buttons-row">
              <a href="/kontakt" class="btn-primary button-row w-inline-block">
                <div class="flex-horizontal">
                  <div>Kontaktformular</div>
                  <div class="arrow-icon">&#xE900;</div>
                </div>
              </a>
              <a href="/kontakt" class="btn-secondary white green-custom hidden w-inline-block">
                <div class="flex-horizontal padding-custom">
                  <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/682f0a2854d6f9fb2051432f_phone-call.png" loading="lazy" alt="Schwarzes Telefonicon - Hepa Baut" class="image-4" />
                  <div class="text-block-4">06209 298 1678</div>
                </div>
              </a>
              <a href="#" class="cta-telefonnummer w-inline-block">
                <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/682f0a2854d6f9fb2051432f_phone-call.png" loading="lazy" alt="" class="image-3 invert" />
                <p class="cta-telefonnummer white">+49 6209 298 16 78</p>
              </a>
            </div>
          </div>
        </div>
        <div class="logo-wrapper">
          <div class="w-layout-grid grid-6-columns logo-strip">
            <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7d50_logo-google-startuply-x-webflow-template.svg" alt="Google Logo - Startply X Webflow Template" class="image google-logo" />
            <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7d52_logo-facebook-startuply-x-webflow-template.svg" alt="Facebook Logo - Startply X Webflow Template" />
            <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7d51_logo-youtube-startuply-x-webflow-template.svg" alt="YouTube Logo - Startply X Webflow Template" />
            <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7d58_logo-pinterest-startuply-x-webflow-template.svg" alt="Pinterest Logo - Startply X Webflow Template" />
            <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7d55_logo-twitch-startuply-x-webflow-template.svg" alt="Twitch Logo - Startply X Webflow Template" class="image twitch-logo" />
            <img src="/cdn/67eacdeb6f6d737ef0fa7cd2/67eacdeb6f6d737ef0fa7d4f_logo-webflow-startuply-x-webflow-template.svg" alt="Webflow Logo - Startply X Webflow Template" />
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Leistungs-Kacheln -->
  <ServiceTiles
    heading="Hepa Baut: Sauber, Zuverlässig und on-time"
    intro="Ganz egal was bei Ihnen auf der Baustelle ansteht. Hepa Baut ist Ihr zuverlässiger Partner"
  />

  <!-- Warum HepaBaut -->
  <UspGrid heading="Warum HepaBaut" ctaLabel="Unverbindlich Beraten" />

  <!-- Projekte -->
  <Projekte />

  <!-- Vorher / Nachher -->
  <VorherNachher />

  <!-- Im Original versteckte Sections (hidden) — für DOM-/Text-Parität mitgeführt -->
  <div class="mg-section-3 mg-top-16px mg-bottom-111px hidden">
    <section class="section-3 hero v2">
      <div class="w-layout-blockcontainer container-default-7 w-container">
        <div class="inner-container _1016px custom">
          <div class="inner-container _500px---mbl">
            <h2 class="display-15 color-neutral-803"><span>Es wird Zeit auch Ihr Zuhause zu Transformieren!</span></h2>
            <div class="inner-container _558px">
              <div class="buttons-row">
                <a href="/kontakt" class="btn-primary-6 w-inline-block">
                  <div class="flex-horizontal-2">
                    <div>Kontaktformular</div>
                    <div class="arrow-icon">&#xE900;</div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <div class="mg-section hidden">
    <section class="section position-relative">
      <div class="container-default w-container">
        <div class="inner-container _600px---tablet center">
          <div class="inner-container _500px---mbl center">
            <div class="inner-container _550px center">
              <div class="text-center mg-bottom-32px">
                <div class="accent-line center"></div>
                <h2 class="display-2 color-neutral-100">Hepa Solar in Zahlen</h2>
              </div>
            </div>
            <div class="w-layout-grid grid-3-columns stats-v2-grid">
              <div class="stats-v2">
                <div>
                  <div class="heading-h1-size color-neutral-100 mg-bottom-16px">40<span class="color-accent-1">+</span></div>
                  <h3 class="display-4 color-neutral-100 mg-bottom-16px">Zufriedene Kunden</h3>
                </div>
                <div class="divider _0px---32px bg-neutral-500"></div>
              </div>
              <div class="stats-v2">
                <div>
                  <div class="heading-h1-size color-neutral-100 mg-bottom-16px">3<span class="color-accent-1">+</span></div>
                  <h3 class="display-4 color-neutral-100 mg-bottom-16px">Jahre auf dem Markt</h3>
                </div>
                <div class="divider _0px---32px bg-neutral-500"></div>
              </div>
              <div class="stats-v2">
                <div>
                  <div class="heading-h1-size color-neutral-100 mg-bottom-16px">500<span class="color-accent-1">qm</span></div>
                  <h3 class="display-4 color-neutral-100 mg-bottom-16px">Photovoltaik verlegt</h3>
                </div>
                <div class="divider _0px---32px bg-neutral-500"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-color-section _100"></div>
    </section>
  </div>

  <!-- Testimonial-CTA -->
  <CtaBand
    heading={'"Vom Rohbau bis zum letzten Pinselstrich - alles perfekt"'}
    subline="-Fam. Schneider, Weinheim"
  />

  <!-- Kontakt-CTA -->
  <div class="div-block-2">
    <CtaBand heading="Kontaktieren Sie uns noch heute und erhalten Sie ein unverbindliches Angebot." showPhone={false} />
  </div>

  <!-- FAQ -->
  <FaqAccordion heading="Oft gestellte Fragen" items={faq} />
</BaseLayout>
