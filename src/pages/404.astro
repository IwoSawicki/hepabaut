---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Seite nicht gefunden - HePa Baut">
  <section class="section pd-150px">
    <div class="container-default w-container">
      <div class="inner-container _574px center">
        <div class="text-center">
          <div class="accent-line center"></div>
          <h1 class="display-2 mg-bottom-0">Seite nicht gefunden</h1>
          <p class="mg-top-32px">Die angeforderte Seite existiert nicht (mehr). Besuchen Sie unsere Startseite oder kontaktieren Sie uns direkt.</p>
          <div class="buttons-row center mg-top-32px">
            <a href="/" class="btn-primary button-row w-inline-block">
              <div class="flex-horizontal">
                <div>Zur Startseite</div>
                <div class="arrow-icon">&#xE900;</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
